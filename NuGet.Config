<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Hosts the real Outward.GameLibs; nuget.org only has a 0.0.0-placeholder.0 name reservation. -->
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <!-- More specific patterns win, so Outward.*, BepInEx.* and UnityEngine.Modules can only come from the BepInEx feed. -->
  <packageSourceMapping>
    <packageSource key="BepInEx">
      <package pattern="BepInEx.*" />
      <package pattern="Outward.*" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
